# ==============================================
# PropVault Environment Configuration Example
# ==============================================

# General Django Settings
DEBUG=True
SECRET_KEY=django-insecure-propvault-development-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DB_NAME=propvault_dev
DB_USER=propvault
DB_PASSWORD=propvault123
DB_HOST=localhost
DB_PORT=5432

# Redis Cache & Celery
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PropVault <noreply@propvault.in>

# AWS S3 Media Storage (required in production; bucket must block public access)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_QUERYSTRING_EXPIRE=3600

# Listings
LISTING_VALIDITY_DAYS=90
LISTING_MAX_MEDIA=20
LISTING_AUTO_HIDE_REPORTS=5

# Sentry (Optional for error tracking)
SENTRY_DSN=
